    {
      "id": "atvncg26-01-hoa-tam",
      "title": "Hỏa Tâm (Mở màn)",
      "artist": "33 Anh Tài",
      "sections": [
        {
          "tag": "Intro",
          "singAlong": false,
          "lines": [
            { "t": "[Chương 1: Đồng tâm & Hợp lực — Ca khúc chủ đề mở màn]" },
            { "t": "(Bật lightstick — chuẩn bị hô vang cùng 33 Anh Tài)" }
          ]
        },
        {
          "tag": "Verse 1",
          "singAlong": false,
          "lines": [
            { "t": "(Dán lời Verse 1 của Hỏa Tâm tại nút Sửa lời trong StageLine)" }
          ]
        },
        {
          "tag": "Chorus",
          "singAlong": true,
          "lines": [
            { "t": "(Dán điệp khúc Hỏa Tâm — đoạn này tự động nổi màu vàng Sing-along)" }
          ]
        },
        {
          "tag": "Sing-along",
          "singAlong": true,
          "lines": [
            { "t": "(Đoạn hòa giọng khán giả & fanchant cao trào)" }
          ]
        }
      ]
    },
